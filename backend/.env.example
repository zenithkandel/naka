# BorderVision Backend Environment
# Copy this to .env and fill in production values

# Application
DEBUG=true
SECRET_KEY=dev-secret-change-in-production

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bordervision
POSTGRES_USER=bv_admin
POSTGRES_PASSWORD=bv_secure_password_change_me

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
